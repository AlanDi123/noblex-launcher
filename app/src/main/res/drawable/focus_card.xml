        <shape android:shape="rectangle">
            <solid android:color="#E6203033" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#FFF4F7F6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80182224" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#557C8988" />
        </shape>
    </item>
</selector>
